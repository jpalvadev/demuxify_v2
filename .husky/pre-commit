#!/usr/bin/env bash
# Nothing staged → skip the whole check cycle: git itself will then refuse the
# commit with its own message. Without this guard a lost `git add` (e.g. a
# timed-out stage step) burns the full check + typecheck + suite run first.
if [ -z "$(git diff --cached --name-only)" ]; then
  echo "husky: nothing staged — skipping checks"
  exit 0
fi

npx lint-staged
npm run check:glossary
npm run check:doc-anchors
npm run check:test-fixtures
npm run check:testids
npm run check:retired-affordances
npm run check:dist-fresh
npm run typecheck
# The suite runs through scripts/vitest-summary.mjs, NOT raw vitest: same suite,
# same exit code (red still aborts the commit), but `git commit` gets its compact
# failure list instead of ~40 k lines of raw vitest output on every commit.
npm run test:report
